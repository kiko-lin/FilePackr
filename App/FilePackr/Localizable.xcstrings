    "help.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and edit compressed archives, and extract everything or just what you pick, without unpacking the whole archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre y edita archivos comprimidos, y extrae todo o solo lo que elijas, sin necesidad de descomprimir el archivo completo."
          }
        }
      }
    },
