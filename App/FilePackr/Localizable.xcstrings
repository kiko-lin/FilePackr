        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarcar un formato no se lo devuelve a otra app; usa «Abrir con → Cambiar todos» en el Finder para elegir otra app por defecto."
          }
        }
      }
    },
