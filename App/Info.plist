			<key>UTTypeIconFile</key><string>FormatIcon-TAR</string>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>tar.xz</string><string>txz</string></array></dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.filepackr.tar-bzip2</string>
