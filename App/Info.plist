	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.filepackr.tar-xz</string>
			<key>UTTypeDescription</key><string>Xz-compressed TAR archive</string>
